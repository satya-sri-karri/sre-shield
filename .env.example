# SRE-Shield Environment Configuration

# LLM Configuration (Groq API)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
# Default uses local SQLite. For production Postgres with pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sreshield
DATABASE_URL=sqlite+aiosqlite:///./data/sre_shield.db

# Hindsight Agent Memory Configuration
# Hindsight endpoint and key (if connecting to hosted Hindsight instance)
HINDSIGHT_API_KEY=
HINDSIGHT_ENDPOINT=https://api.hindsight.vectorize.io/v1
HINDSIGHT_BANK_NAME=sre-shield-production

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501

# Execution Safety Mode
# Setting to TRUE simulates shell commands with realistic metrics.
SIMULATION_MODE=true
